# 服务端口
PORT=3000

# 日志级别
LOG_LEVEL=info

# 数据库路径（相对于 server/）
DB_PATH=./data/outlook.db

# 访问密码（留空则不启用认证）
ACCESS_PASSWORD=

# 单个账户单个文件夹一次收取的总时限，秒（含 Graph / IMAP 全部回退通道）。
# 到时仍未完成则返回「收取超时」（有本地缓存时显示缓存），批量收取不会卡住。网络很慢时可调大。
FETCH_TIMEOUT=45

# 单个 HTTP（OAuth / Graph）请求超时，秒
HTTP_REQUEST_TIMEOUT=20

# IMAP 连接超时，秒
IMAP_TIMEOUT=20

# IMAP ID（网易 163/126 需要客户端发送 ID，否则 SELECT 报 Unsafe Login）
IMAP_ID_NAME=outlookEmail
IMAP_ID_VERSION=2.0.0
IMAP_ID_VENDOR=outlookEmail
IMAP_ID_SUPPORT_EMAIL=
